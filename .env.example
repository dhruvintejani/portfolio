# Configure these in Vercel → Project → Settings → Environment Variables.
# DO NOT expose RESEND_API_KEY as a VITE_ variable or commit its actual value.
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=Portfolio <hello@your-verified-domain.com>
# Optional: comma-separated preview deployment origins (without trailing slash)
CONTACT_ALLOWED_ORIGINS=
